# Copy to .env.local. `neon deploy` fills in the Neon and storage values for you.

# Site (canonical URLs, sitemap, robots.txt, OG images)
NEXT_PUBLIC_SITE_URL=https://keyclash.princeshah.me

# Neon Postgres
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=

# Neon Auth
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
# 32+ random chars: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Neon Realtime (live leaderboards, rooms, thock count)
NEON_REALTIME_URL=
NEON_REALTIME_SECRET=
# Same value as NEON_REALTIME_URL
NEXT_PUBLIC_NEON_REALTIME_URL=

# Neon Object Storage (avatars, sound packs)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
